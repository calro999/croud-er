  "review": "\n<!-- 個別詳細レビューコンテナ -->\n<div class=\"space-y-8\">\n  <!-- ファーストビュー・作品ヘッダー -->\n  <div class=\"bg-gradient-to-br from-slate-900 via-slate-900 to-rose-950/30 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-2xl flex flex-col md:flex-row gap-6 items-start\">\n    <div class=\"w-full md:w-1/3 flex-shrink-0\">\n      <div class=\"relative rounded-2xl overflow-hidden shadow-2xl border border-slate-700/80 group\">\n        <img src=\"https://pics.dmm.co.jp/digital/video/1namh00014/1namh00014pl.jpg\" alt=\"歯科衛生士さんを初真正中出し 子宮に本物ザーメン11発 りあ（貯金大好き）\" class=\"w-full h-auto object-cover group-hover:scale-105 transition duration-500\" loading=\"eager\" />\n        <div class=\"absolute top-3 left-3 bg-rose-600/90 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg backdrop-blur-sm\">\n          特集第5位\n        </div>\n      </div>\n    </div>\n    <div class=\"w-full md:w-2/3 flex flex-col justify-between space-y-4\">\n      <div>\n        <div class=\"text-xs font-bold text-rose-400 tracking-wider uppercase mb-1.5 flex items-center gap-1.5\">\n          <span>🏆</span> 【診察台の死角・歯科衛生士の胸押し付け密着治療】FANZA「白衣の天使・目隠しタ...\n        </div>\n        <h1 class=\"text-xl md:text-2xl font-black text-white leading-snug\">歯科衛生士さんを初真正中出し 子宮に本物ザーメン11発 りあ（貯金大好き）</h1>\n      </div>\n\n      <div class=\"space-y-2 text-sm text-slate-300\">\n        <p><strong class=\"text-slate-400\">出演キャスト：</strong> <a href=\"/actress/%E5%A4%A2%E5%B7%9D%E3%82%8A%E3%81%82\" class=\"text-rose-400 hover:text-rose-300 underline font-bold transition\">夢川りあ</a></p>\n        <p><strong class=\"text-slate-400\">メーカー：</strong> <span class=\"text-slate-200\">なまなま</span></p>\n        <p><strong class=\"text-slate-400\">品番・CID：</strong> <span class=\"font-mono text-amber-300 font-bold\">1namh00014</span></p>\n        <p><strong class=\"text-slate-400\">抜擢理由：</strong> <span class=\"text-rose-300 font-medium\">現役衛生士の素朴な肉体に放つ本物中出し11連発</span></p>\n      </div>\n\n      <!-- キラーポイント箇条書き -->\n      <div class=