ass=\"text-slate-300 hover:text-amber-300 bg-slate-800/80 hover:bg-slate-700/80 px-2.5 py-1 rounded-full text-xs font-medium border border-slate-700 transition\">デート</a> <a href=\"/genre/hame-tori\" class=\"text-slate-300 hover:text-amber-300 bg-slate-800/80 hover:bg-slate-700/80 px-2.5 py-1 rounded-full text-xs font-medium border border-slate-700 transition\">ハメ撮り</a>\n    </div>\n  </div>\n</div>\n"
