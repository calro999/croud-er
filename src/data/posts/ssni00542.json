  "review": "<!-- 個別作品詳細レビューコンテナ -->\n<div class=\"space-y-6\">\n  <!-- パッケージ＆基本情報カード -->\n  <div class=\"bg-slate-900 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-2xl flex flex-col md:flex-row gap-6 items-center md:items-start\">\n    <div class=\"w-full md:w-1/3 flex-shrink-0\">\n      <div class=\"relative rounded-2xl overflow-hidden shadow-xl border border-slate-700/50 group\">\n        <img src=\"https://pics.dmm.co.jp/digital/video/ssni00542/ssni00542pl.jpg\" alt=\"NTR同窓会 愛する妻と最悪な元彼の気が狂いそうな胸糞浮気映像。 三上悠亜\" class=\"w-full h-auto object-cover group-hover:scale-105 transition duration-500\" loading=\"eager\" />\n        <div class=\"absolute top-3 left-3 bg-rose-600/90 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg backdrop-blur-sm\">\n          厳選神作\n        </div>\n      </div>\n    </div>\n    <div class=\"w-full md:w-2/3 flex flex-col justify-between space-y-4\">\n      <div>\n        <div class=\"text-xs font-bold text-amber-400 tracking-wider uppercase mb-1\">エスワン ナンバーワンスタイル</div>\n        <h1 class=\"text-xl md:text-2xl font-extrabold text-white leading-snug\">NTR同窓会 愛する妻と最悪な元彼の気が狂いそうな胸糞浮気映像。 三上悠亜</h1>\n      </div>\n      <div class=\"space-y-2 text-sm text-slate-300\">\n        <p><strong class=\"text-slate-400\">出演女優：</strong> <a href=\"/actress/mikami-yua\" class=\"text-rose-400 hover:text-rose-300 underline font-bold transition\">三上悠亜</a></p>\n        <p><strong class=\"text-slate-400\">配信形式：</strong> 動画配信（HD / 4Kストリーミング＆ダウンロード）</p>\n        <p><strong class=\"text-slate-400\">品番・CID：</strong> <span class=\"font-mono text-slate-200\">ssni00542</span></p>\n        <p><strong class=\"text-slate-400\">特化ポイント：</strong> <span class=\"text-amber-300 font-semibold\">愛する夫がいるのに同窓会で最悪な元彼に捕まり弱みを握られ狂乱凌辱される三上悠亜</span></p>\n      </div>\n\n      <!-- キラーポイント箇条書き -->\n      <div class=\"bg-slate-800/40 rounded-2xl p-4 border border-slate-700/40\">\n        <h4 class=\"text-xs font-bold text-amber-400 uppercase tracking-wider mb-2\">🔥 本作の抜きどころ・実