1 md:grid-cols-12 gap-6 items-start\">\n        <div class=\"md:col-span-5 space-y-3\">\n          <div class=\"relative overflow-hidden rounded-xl border border-slate-700 bg-slate-950 shadow-inner group\">\n            <img src=\"https://pics.dmm.co.jp/digital/video/mkmp00753/mkmp00753pl.jpg\" alt=\"お漏らし工場 中卒元ヤンのパワハラ主任は、唯一の女性であり…職場のガン。女子トイレを撤去された彼女は、今では小便垂れ流しの肉便器です。 乙アリス\" class=\"w-full h-auto object-cover transform group-hover:scale-105 transition duration-300\" loading=\"lazy\" />\n          </div>\n          <div class=\"p-3 bg-slate-950/80 rounded-lg border border-slate-800 text-xs space-y-1 text-slate-400 font-mono\">\n            <div><strong class=\"text-slate-300 font-sans\">出演女優:</strong> 乙アリス</div>\n            <div><strong class=\"text-slate-300 font-sans\">メーカー:</strong> million</div>\n            <div><strong class=\"text-slate-300 font-sans\">レーベル:</strong> IROKE</div>\n            <div><strong class=\"text-slate-300 font-sans\">参考価格:</strong> 990~</div>\n          </div>\n          <a href=\"https://al.fanza.co.jp/?lurl=https%3A%2F%2Fvideo.dmm.co.jp%2Fav%2Fcontent%2F%3Fid%3Dmkmp00753&af_id=onchan555-003&ch=api\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"block w-full text-center py-3 px-4 bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white font-bold rounded-xl shadow-lg transform hover:-translate-y-0.5 transition duration-150\">\n            FANZA公式で作品詳細・本編を見る ➔\n          </a>\n        </div>\n\n        <div class=\"md:col-span-7 space-y-4 text-slate-300 leading-relaxed text-sm md:text-base\">\n          <div class=\"p-4 bg-slate-950/50 rounded-xl border-l-2 border-pink-500\">\n            <h5 class=\"text-xs uppercase tracking-wider text-pink-400 font-bold mb-1\">作品あらすじ・ストーリー</h5>\n            <p class=\"text-xs md:text-sm text-slate-300 line-clamp-4 leading-relaxed\">お漏らし工場 中卒元ヤンのパワハラ主任は、唯一の女性であり…職場のガン。女子トイレを撤去された彼女は、今では小便垂れ流しの肉便器です。 乙アリス</p>\n          </div>\n\n          <div class=\"space-y-3\