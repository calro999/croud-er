-slate-900/80 shadow-md\">\n      <table class=\"w-full text-left text-xs md:text-sm text-slate-300 divide-y divide-slate-800\">\n        <thead class=\"bg-slate-950/80 text-pink-400 font-semibold\">\n          <tr>\n            <th class=\"p-3\">作品名 / 品番</th>\n            <th class=\"p-3\">主演出演者</th>\n            <th class=\"p-3\">メーカー / レーベル</th>\n            <th class=\"p-3\">抜きどころ・最大の見せ場</th>\n            <th class=\"p-3 text-center\">公式配信</th>\n          </tr>\n        </thead>\n        <tbody class=\"divide-y divide-slate-800/60\">\n          <tr class=\"hover:bg-slate-800/40 transition\">\n            <td class=\"p-3 font-medium text-white max-w-xs truncate\">ピラティス中のデカ尻義姉に即ハメピストン！ピラティスに夢中の義姉のパツパツ尻や谷間が見えまくりで超絶エロい！ <br><span class=\"text-xs text-pink-400 font-mono\">HUNTC00518</span></td>\n            <td class=\"p-3 text-slate-300\">単体・企画女優</td>\n            <td class=\"p-3 text-slate-400\">Hunter</td>\n            <td class=\"p-3 text-slate-300\">至近距離密着ピストン＆濃厚フィニッシュ</td>\n            <td class=\"p-3 text-center\"><a href=\"https://al.fanza.co.jp/?lurl=https%3A%2F%2Fvideo.dmm.co.jp%2Fav%2Fcontent%2F%3Fid%3Dhuntc00518&af_id=onchan555-003&ch=api\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-3 py-1 bg-pink-600 hover:bg-pink-500 text-white rounded text-xs font-semibold shadow\">本編を見る</a></td>\n          </tr>\n          <tr class=\"hover:bg-slate-800/40 transition\">\n            <td class=\"p-3 font-medium text-white max-w-xs truncate\">初撮り 上級国民の秘密妻。何不自由ない生活から女性としての自由な輝きを求めたハズが潮吹き馬鹿マ○コを晒しAV出演。 二階堂美雨 <br><span class=\"text-xs text-pink-400 font-mono\">PRWF00013</span></td>\n            <td class=\"p-3 text-slate-300\">二階堂美雨</td>\n            <td class=\"p-3 text-slate-400\">プレミアム</td>\n            <td class=\"p-3 text-slate-300\">至近距離密着ピストン＆濃厚フィニッシュ</td>\n            <td class=\"p-3 text-center\"><a href=\"https://al.fanza.co.jp/?lurl=https%3A%2F%2Fvideo.dmm.co.jp%2Fav%2Fcontent%2F%3Fid%3Dprwf00013&af_id=onchan555-003&ch=api\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-3 py-1 bg-pink-600 hover:bg-pink-500 text-white rounded text-xs font-semibold shadow\">本編を見る</a></td>\n          </tr>\n          <tr class=\"hover:bg-slate-800/40 transition\">\n            <td class=\"p-3 font-medium text-white max-w-xs truncate\">THE ドキュメント 本能丸出しでする絶頂SEX 肉食系美人若妻がSEXを我慢出来ず極太チ○ポ乱交中出し狂いまくる 胡桃さくら <br><span class=\"text-xs text-pink-400 font-mono\">BIJN00288</span></td>\n            <td class=\"p-3 text-slate-300\">胡桃さくら</td>\n            <td class=\"p-3 text-slate-400\">美人魔女/エマニエル</td>\n            <td class=\"p-3 text-slate-300\">至近距離密着ピストン＆濃厚フィニッシュ</td>\n            <td class=\"p-3 text-center\"><a href=\"https://al.fanza.co.jp/?lurl=https%3A%2F%2Fvideo.dmm.co.jp%2Fav%2Fcontent%2F%3Fid%3Dbijn00288&af_id=onchan555-003&ch=api\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-3 py-1 bg-pink-600 hover:bg-pink-500 text-white rounded text-xs font-semibold shadow\">本編を見る</a></td>\n          </tr>\n          <tr class=\"hover:bg-slate-800/40 transition\">\n            <td class=\"p-3 font-medium text-white max-w-xs truncate\">ガチ狂い崩壊美人妻 牧田充希 <br><span class=\"text-xs text-pink-400 font-mono\">KHSK00002</span></td>\n            <td class=\"p-3 text-slate-300\">牧田充希</td>\n            <td class=\"p-3 text-slate-400\">豊彦</td>\n            <td class=\"p-3 text-slate-300\">至近距離密着ピストン＆濃厚フィニッシュ</td>\n            <td class=\"p-3 text-center\"><a href=\"https://al.fanza.co.jp/?lurl=https%3A%2F%2Fvideo.dmm.co.jp%2Fav%2Fcontent%2F%3Fid%3Dkhsk00002&af_id=onchan555-003&ch=api\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-3 py-1 bg-pink-600 hover:bg-pink-500 text-white rounded text-xs font-semibold shadow\">本編を見る</a></td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <!-- 作品別徹底詳細レビュー（1作品ずつ長文解説） -->\n  <section class=\"space-y-12\">\n    <div class=\"flex items-center gap-2 border-l-4 border-pink-500 pl-3\">\n      <h3 class=\"text-